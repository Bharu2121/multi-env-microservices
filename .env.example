# Common Environment Variables Example (Copy to .env for local testing)
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# ----------------------------------------------------
# Application Profiles (dev, qa, staging, prod)
# ----------------------------------------------------
SPRING_PROFILES_ACTIVE=dev

# ----------------------------------------------------
# Database Configuration (Required for order-service)
# ----------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/orders_db
DB_USER=postgres
DB_PASSWORD=devpassword

# ----------------------------------------------------
# Security & Tokens (Required for auth-service)
# ----------------------------------------------------
JWT_SECRET=supersecret-dummy-jwt-placeholder-key-min-32chars

# ----------------------------------------------------
# AWS & Cloud Placeholders (Non-secret placeholders)
# ----------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=<AWS_ACCOUNT_ID>
ECR_REPOSITORY_URI=<AWS_ACCOUNT_ID>.dkr.ecr.us-east-1.amazonaws.com
